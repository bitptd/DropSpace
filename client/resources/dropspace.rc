IDI_ICON1 ICON "app.ico"

1 VERSIONINFO
 FILEVERSION 1,0,6,0
 PRODUCTVERSION 1,0,6,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName", "DropSpace"
      VALUE "FileDescription", "DropSpace Windows Client"
      VALUE "FileVersion", "1.0.6"
      VALUE "InternalName", "DropSpace"
      VALUE "OriginalFilename", "DropSpace.exe"
      VALUE "ProductName", "DropSpace"
      VALUE "ProductVersion", "1.0.6"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
